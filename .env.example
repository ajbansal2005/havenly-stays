# ==========================================
# StayHub Environment Configuration Template
# Copy this file to .env and fill in credentials
# ==========================================

# Application Settings
APP_NAME=StayHub
APP_TAGLINE="Find and book unique stays around the world"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
CURRENCY_SYMBOL=₹
CURRENCY_CODE=INR

# Database Credentials
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=airbnb_db
DB_USER=root
DB_PASS=

# Razorpay Payment Gateway (Test Mode Credentials)
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YourTestKeyId
RAZORPAY_KEY_SECRET=YourTestKeySecret
RAZORPAY_TEST_MODE=true

# Email & SMTP Credentials (PHPMailer / Mailtrap / Gmail)
MAIL_ENABLED=true
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=no-reply@stayhub.test
SMTP_FROM_NAME="StayHub Bookings"

# EmailJS Configuration
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=
EMAILJS_REGISTRATION_TEMPLATE_ID=your_registration_template_id
EMAILJS_BOOKING_TEMPLATE_ID=your_guest_booking_template_id
EMAILJS_HOST_BOOKING_TEMPLATE_ID=your_host_booking_template_id
