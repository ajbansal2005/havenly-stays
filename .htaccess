# StayHub Apache Security & Routing Configuration

# Prevent Directory Browsing
Options -Indexes

# Default Index File
DirectoryIndex index.php

# Prevent direct access to sensitive data files
<FilesMatch "\.(sqlite|sql|log|bat|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Custom 404 Error Document
ErrorDocument 404 /404.php

# Enable UTF-8 Charset
AddDefaultCharset UTF-8
