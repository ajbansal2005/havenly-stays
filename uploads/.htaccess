# Security: Disable script execution in uploads folder
# Mitigates any Remote Code Execution (RCE) via uploaded files

Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .phar .cgi .pl .sh .exe
RemoveType .php .phtml .php3 .php4 .php5 .phar .cgi .pl .sh .exe

<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|phar|cgi|pl|sh|exe|jsp|asp|aspx|shtml|pht|svg)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Only permit safe raster images
<FilesMatch "(?i)\.(jpg|jpeg|png|webp|gif|ico)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>
